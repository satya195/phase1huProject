{
  "version": 2,
  "name": "stinger-frontend",
  "builds": [
    {
      "src": "Fontend/package.json",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://stinger-backend.railway.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Fontend/dist/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://stinger-backend.railway.app"
  },
  "build": {
    "env": {
      "VITE_API_URL": "https://stinger-backend.railway.app"
    }
  },
  "functions": {
    "Fontend/dist/index.html": {
      "includeFiles": "Fontend/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
} 